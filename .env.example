# Azure OpenAI 配置
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI 部署名稱
AZURE_OPENAI_GPT4O_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_O3MINI_DEPLOYMENT_NAME=o3-mini

# OpenAI 配置
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Web Search 配置
OLLAMA_API_KEY=your-ollama-web-search-api-key-here
OLLAMA_WEB_SEARCH_BASE_URL=https://ollama.com/api
OLLAMA_WEB_SEARCH_TIMEOUT=30
OLLAMA_WEB_SEARCH_MAX_RESULTS=10
OLLAMA_WEB_SEARCH_ENABLED=true

# Anthropic 配置 (可選)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -------------------------------
# Azure AI Foundry (範例)
# Foundry 常以 model_id 或 model 名稱呼叫，請在 models config 中提供 model_id
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.azure.com
AZURE_AI_FOUNDRY_API_KEY=your-foundry-api-key
AZURE_AI_FOUNDRY_API_VERSION=2024-10-01
AZURE_AI_FOUNDRY_MODEL_ID=foundry-model-id

# 使用說明：
# - 若 provider 為 azure_openai，請填寫 AZURE_OPENAI_* 系列變數並在 model config 提供 deployment_name
# - 若 provider 為 azure_ai_foundry，請填寫 AZURE_AI_FOUNDRY_* 系列變數並在 model config 提供 model_id

# 說明：
# 1. 複製此檔案為 .env
# 2. 填入您的實際 API 金鑰和端點
# 3. 確保 .env 檔案不會被提交到版本控制中